{
	"schemaVersion": 1,
	"id": "flowtrails",
	"version": "${version}",
	"name": "FlowTrails",
	"description": "Smooth, fading motion trails that flow from players' hands and feet.",
	"authors": [
		"mesdev"
	],
	"contact": {
		"homepage": "https://github.com/mesoooo/FlowTrails",
		"sources": "https://github.com/mesoooo/FlowTrails",
		"issues": "https://github.com/mesoooo/FlowTrails/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"xyz.mesdev.flowtrails.FlowTrailsClient"
		],
		"modmenu": [
			"xyz.mesdev.flowtrails.compat.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${mcRange}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
